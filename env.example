# Server-only PostgreSQL connection. Supabase transaction pooler (:6543) is
# recommended for ephemeral Vercel API workers; localhost session pooler (:5432)
# also works. Never prefix credentials with NEXT_PUBLIC_.

DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"

# OPTIONAL: dedicated, session-capable connection for LISTEN/NOTIFY SSE.
# When omitted, DATABASE_URL is used unless its port is 6543; in that case
# SSE is disabled and spectator polling (15 seconds) remains available.

# WEJI_LISTEN_DATABASE_URL="postgresql://USER:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require"

# Exactly ONE admin. No signup, staff roles or multi-admin.
WEJI_ADMIN_USERNAME="panitia"

# Generate locally: npm run admin:hash
WEJI_ADMIN_PASSWORD_HASH="PASTE_SCRYPT_HASH_HERE"

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
WEJI_SESSION_SECRET="REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS"
