# PostgreSQL / Supabase connection string server-side, not NEXT_PUBLIC_
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Satu akun panitia V2.2 (tidak ada self-signup/role operator)
WEJI_ADMIN_USERNAME="panitia"
# Generate: npm run admin:hash
WEJI_ADMIN_PASSWORD_HASH="PASTE_SCRYPT_HASH_HERE"
# Minimal 32 karakter acak, rahasia dan stabil (contoh generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
WEJI_SESSION_SECRET="REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS"
